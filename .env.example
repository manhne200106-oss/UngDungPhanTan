# ==============================================================================
# BulkNotificationSystem - Environment Configuration Example
# Copy this file to .env and replace placeholder values with your local settings.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# 1. Khi chạy trong Docker Compose:
#    Sử dụng service name 'postgres' làm host (mạng nội bộ Docker).
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=bulk_notification;Username=bulk_user;Password=CHANGE_ME

# 2. Khi chạy trực tiếp trên WSL2 / Host (ngoài Docker):
#    Bỏ comment dòng dưới và sử dụng 'localhost' với cổng được expose:
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=bulk_notification;Username=bulk_user;Password=CHANGE_ME

# ------------------------------------------------------------------------------
# RabbitMQ Message Broker Configuration
# ------------------------------------------------------------------------------
# 1. Khi chạy trong Docker Compose:
#    Sử dụng service name 'rabbitmq' làm host (mạng nội bộ Docker).
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=bulk_user
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_VHOST=/

# 2. Khi chạy trực tiếp trên WSL2 / Host (ngoài Docker):
#    Bỏ comment cấu hình dưới và kết nối tới 'localhost' (cổng expose trên host):
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# RABBITMQ_MANAGEMENT_PORT=15672
# RABBITMQ_USER=bulk_user
# RABBITMQ_PASSWORD=CHANGE_ME
# RABBITMQ_VHOST=/

# ------------------------------------------------------------------------------
# SMTP / Email Service Configuration (e.g. Mailpit)
# ------------------------------------------------------------------------------
# Docker Compose network: Host=mailpit | Khi chạy trên Host: Host=localhost
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=false
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Bulk Notification System

# ------------------------------------------------------------------------------
# Service Endpoints / URLs
# ------------------------------------------------------------------------------
CAMPAIGN_API_URL=http://localhost:5000
ADMIN_WEB_URL=http://localhost:5002
